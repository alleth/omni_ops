# .jfif is a JPEG under the hood, but XAMPP's default Apache mime.types
# doesn't map the extension to image/jpeg (only jpeg/jpg/jpe) -- without this,
# Apache serves .jfif attachments as application/octet-stream, which some
# browsers force-download instead of rendering, breaking "Open in New Tab"
# for pull-out/relocation form uploads. Requires mod_mime, already enabled
# in this project's XAMPP setup.
<IfModule mod_mime.c>
    AddType image/jpeg .jfif
</IfModule>

# Uploads are user-supplied and served straight off disk by Apache (webroot/.htaccess
# only rewrites to index.php when the file does NOT exist). Nothing in here should ever
# be executed as code -- RequestTblController validates type on upload, but this is the
# backstop if a bad file ever lands here anyway.
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Strip handlers/types so a stray .php/.phtml/.cgi is served as plain bytes, not run.
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps .cgi .pl .py .jsp .asp .shtml
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phps .cgi .pl .py .jsp .asp .shtml
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .phps .cgi .pl .py .jsp .asp .shtml

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
