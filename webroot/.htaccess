# Compress static assets (React JS/CSS bundles) — requires mod_deflate to be
# enabled in httpd.conf (LoadModule deflate_module modules/mod_deflate.so).
# API JSON responses are compressed in PHP (App\Middleware\GzipMiddleware)
# and do not depend on this.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Serve React from /public/ — fallback to index.html for SPA routing
    RewriteCond %{REQUEST_URI} ^/public/ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^public/(.*)$ public/index.html [L]

    # CakePHP fallback (non-/public routes)
    RewriteCond %{REQUEST_URI} !^/public/ [NC]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
